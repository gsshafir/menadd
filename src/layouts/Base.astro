---
import "../styles/global.css";
import { nav, site } from "../data";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  noindex?: boolean;
  wide?: boolean;
};

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogType = "website",
  ogImage = "/og-default.png",
  noindex = false,
  wide = false
} = Astro.props;
const canonicalUrl = new URL(canonical, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();
const currentPath = Astro.url.pathname;
const isCurrentNavItem = (href: string) =>
  href === "/library/"
    ? currentPath.startsWith("/library")
    : currentPath === href || currentPath.startsWith(href);
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "MENADD",
  url: "https://menadd.com"
};
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://menadd.com/about/#gennady",
  name: "Gennady Shafir",
  jobTitle: "CFO & Board Advisor",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Abu Dhabi",
    addressCountry: "AE"
  },
  url: "https://menadd.com/about/",
  sameAs: ["https://www.linkedin.com/in/gennadyshafir"],
  knowsAbout: [
    "cap tables",
    "corporate governance",
    "cross-border structuring",
    "capital readiness",
    "investor due diligence",
    "startup finance"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MENADD. Investor-grade structure for MENA founders." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="MENADD home">
        <span>{site.name}</span>
        <span class="wordmark-author">Gennady Shafir</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isCurrentNavItem(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <a class="button-link header-cta" href="/start/">Start a conversation</a>
    </header>
    <main class:list={{ "wide-main": wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-statement">MENADD. Written by Gennady Shafir. Built from the diligence backwards.</p>
      <div class="footer-links">
        <a href="/library/">Library</a>
        <a href="/assessment/structure/">Structure check</a>
        <a href="/library/#subscribe">Diligence Notes</a>
        <a href={site.linkedIn}>LinkedIn</a>
        <a href="/privacy/">Privacy</a>
        <a href="mailto:gennady@menadd.com">gennady@menadd.com</a>
      </div>
      <p>General information, not legal, tax or investment advice.</p>
      <p>Copyright 2026 MENADD</p>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#site-nav");

      if (toggle && nav) {
        const setExpanded = (expanded: boolean) => {
          toggle.setAttribute("aria-expanded", String(expanded));
        };

        toggle.addEventListener("click", () => {
          setExpanded(toggle.getAttribute("aria-expanded") !== "true");
        });

        nav.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            setExpanded(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setExpanded(false);
            toggle.focus();
          }
        });

        matchMedia("(width < 768px)").addEventListener("change", () => setExpanded(false));
      }
    </script>
  </body>
</html>
